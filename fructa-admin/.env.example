# Supabase — Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=  # SERVER ONLY — never expose to the app

# Cron auth — Vercel auto-provides CRON_SECRET in production.
# Set your own here for local dev so the route accepts your requests.
CRON_SECRET=

# OneSignal (later phase)
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
